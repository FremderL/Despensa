##############################################################################
# Despensa · variables de entorno
#
# Copia este fichero a `.env.local` para desarrollo.
# En Render se definen en el panel del servicio (Environment), NUNCA en el
# repositorio: `.env*` está en .gitignore por ese motivo.
##############################################################################

# ─────────────────────────────── Base de datos ──────────────────────────────
# Neon entrega dos cadenas para la misma base:
#
#   DATABASE_URL          → host con `-pooler`. La usa la aplicación.
#                           Pasa por PgBouncer y aguanta muchas conexiones.
#   DATABASE_URL_UNPOOLED → host sin `-pooler`. SÓLO para migraciones y dumps.
#                           PgBouncer en modo transacción rompe las sentencias
#                           preparadas que necesita una migración.
#
# Si dejas las dos vacías, en desarrollo se usa PGlite (Postgres embebido en
# `.data/pglite`) y la aplicación arranca sin configurar nada.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# TLS contra Postgres. Déjalo en true: Neon lo exige y evita intermediarios.
DATABASE_SSL=true

# ──────────────────────────────── Seguridad ─────────────────────────────────
# Llave HMAC con la que se derivan los hashes de los tokens opacos (sesión,
# invitación, verificación). Si se filtra la base de datos, sin esta clave los
# tokens siguen sin poder reconstruirse.
#
# Genérala con:  openssl rand -base64 48
# Cambiarla invalida todas las sesiones e invitaciones vigentes.
AUTH_SECRET=

# URL pública canónica, sin barra final. Se usa en los enlaces de los correos
# y para validar el origen de las peticiones.
APP_URL=http://localhost:3000

# Permite que la app se muestre dentro de un iframe. Déjalo en false en
# producción: es lo que impide los ataques de clickjacking.
ALLOW_IFRAME_EMBEDDING=false

# ────────────────────────────────── Correo ──────────────────────────────────
# Sin SMTP_URL los mensajes se escriben en el log del servidor y la interfaz
# muestra el enlace directamente (sólo fuera de producción).
#
# Ejemplos:
#   smtps://usuario:clave@smtp.tuservidor.com:465
#   smtp://resend:re_xxxxxxxx@smtp.resend.com:587
SMTP_URL=
MAIL_FROM="Despensa <no-reply@tudominio.com>"

# ──────────────────────────────── Preferencias ──────────────────────────────
# Días de antelación por defecto para avisar de una caducidad. Cada despensa
# puede cambiarlo después desde sus ajustes.
DEFAULT_EXPIRY_WARNING_DAYS=7
